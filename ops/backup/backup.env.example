# =====================================================
# 백업 러너 환경변수 템플릿 — 국내 백업 러너에 backup.env 로 복사
# ⚠️ 실제 비밀값은 저장소에 커밋 금지. 국내 KMS/Secret Manager 에 보관.
# =====================================================

# 운영 DB (backup_runs 기록용, 관리 연결)
SUPABASE_DB_URL="postgresql://postgres:__PW__@db.__PROJECT__.supabase.co:5432/postgres?sslmode=require"

# 백업 전용 읽기전용 롤 (pg_dump 용, 최소권한)
BACKUP_RO_DB_URL="postgresql://backup_ro:__PW__@db.__PROJECT__.supabase.co:5432/postgres?sslmode=require"

# 국내 Object Storage (S3 호환: NCP/KT/Kakao Cloud 등)
OBJ_ENDPOINT="https://kr.object.example.com"
OBJ_BUCKET="emr-backups-kr"
AWS_ACCESS_KEY_ID="__ACCESS_KEY__"
AWS_SECRET_ACCESS_KEY="__SECRET_KEY__"
AWS_DEFAULT_REGION="kr-standard"

# 국내 KMS (봉투암호화 DEK 래핑) — kms_wrap.sh / kms_unwrap.sh 가 사용
KMS_KEY_ID="__KMS_MASTER_KEY_ID__"

# 복구 검증용 격리 스테이징 DB (별도 인스턴스 권장)
STAGING_ADMIN_URL="postgresql://postgres:__PW__@staging-db.internal:5432/postgres?sslmode=require"
STAGING_DB="emr_restore_verify"
